# frozen_string_literal: true

source "https://rubygems.org"

gemspec path: ".."

gem "rails", "~> 6.1.7"
# concurrent-ruby 1.3.5 dropped an implicit `require "logger"` that Rails 6.1 relies on.
gem "concurrent-ruby", "< 1.3.5"

gem "aws-sdk-secretsmanager", "~> 1.0"
gem "rake", "~> 13.0"
gem "rspec", "~> 3.13"
gem "webmock", "~> 3.23"
